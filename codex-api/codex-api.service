[Unit]
Description=Authenticated Codex HTTP API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codex-api
Group=codex-api
Environment=HOME=/var/lib/codex-api
Environment=CODEX_HOME=/var/lib/codex-api/.codex
EnvironmentFile=/etc/codex-api/.env.production
WorkingDirectory=/var/lib/codex-api
ExecStart=/usr/bin/python3 /opt/codex-api/current/gateway.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codex-api
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=4096
TasksMax=128

[Install]
WantedBy=multi-user.target
