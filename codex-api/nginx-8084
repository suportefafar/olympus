server {
    listen 8084 ssl default_server;
    listen [::]:8084 ssl default_server;
    server_name _;
    ssl_certificate /etc/codex-api/tls.crt;
    ssl_certificate_key /etc/codex-api/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/port-8084.access.log;
    error_log /var/log/nginx/port-8084.error.log;
    client_max_body_size 256k;
    location / {
        proxy_pass http://127.0.0.1:18094;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
