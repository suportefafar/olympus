#!/usr/bin/env bash
set -Eeuo pipefail

resolve_self() {
  local path="${BASH_SOURCE[0]}" dir
  while [[ -L "$path" ]]; do
    dir="$(cd -P -- "$(dirname -- "$path")" >/dev/null 2>&1 && pwd)"
    path="$(readlink -- "$path")"
    [[ "$path" = /* ]] || path="$dir/$path"
  done
  cd -P -- "$(dirname -- "$path")" >/dev/null 2>&1 && pwd
}
ROOT="$(resolve_self)"
WORKSPACE="$(cd "$ROOT/.." && pwd -P)"
MANIFEST="$ROOT/apps.tsv"
STATE="$ROOT/state"
HISTORY="$STATE/events.tsv"
LOCK="$STATE/lock"
ENVFILE="$ROOT/.env"
REMOTE_PROD_SSH_HOST="150.164.110.1"
REMOTE_PROD_SSH_PORT="10022"
REMOTE_PROD_SSH_USER="root"

fail() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }
info() { printf '[INFO] %s\n' "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || fail "Required command not found: $1"; }
shell_quote() {
  local value=${1//\'/\'\\\'\'}
  printf "'%s'" "$value"
}
run_remote_prod() {
  local action="$1" arg command="olymctl prod" quoted remote_command update_olympus=true
  shift
  need ssh
  command+=" $(shell_quote "$action")"
  for arg in "$@"; do
    quoted="$(shell_quote "$arg")"
    command+=" $quoted"
    [[ "$arg" != --no-pull ]] || update_olympus=false
  done
  info "Running olymctl prod $action on $REMOTE_PROD_SSH_USER@$REMOTE_PROD_SSH_HOST:$REMOTE_PROD_SSH_PORT"
  remote_command="$command"
  if [[ "$action" == up && "$update_olympus" == true ]]; then
    remote_command='script_path="$(readlink -f "$(command -v olymctl)")" || exit 1
repo="$(dirname "$script_path")" || exit 1
if [ -n "$(git -C "$repo" status --porcelain)" ]; then echo "[ERROR] Olympus checkout has uncommitted changes; refusing self-update." >&2; exit 1; fi
git -C "$repo" fetch origin main || exit 1
git -C "$repo" merge-base --is-ancestor HEAD origin/main || { echo "[ERROR] Olympus has local commits outside origin/main; refusing self-update." >&2; exit 1; }
git -C "$repo" switch --force-create main origin/main || exit 1
exec '
    remote_command+="$command"
  fi
  if [[ "$action" == status ]]; then
    if status_color_enabled; then
      remote_command="OLYMCTL_COLOR=always $command"
    else
      remote_command="OLYMCTL_COLOR=never $command"
    fi
  fi
  ssh -T -p "$REMOTE_PROD_SSH_PORT" "$REMOTE_PROD_SSH_USER@$REMOTE_PROD_SSH_HOST" "$remote_command"
}
run_remote_nextcloud() {
  local cloud_dir="$WORKSPACE/cloud" cloud_commit
  need ssh
  [[ -d "$cloud_dir/.git" ]] || fail "Missing Cloud checkout at $cloud_dir."
  [[ -z "$(git -C "$ROOT" status --porcelain)" ]] || fail "Olympus has uncommitted changes."
  [[ -z "$(git -C "$cloud_dir" status --porcelain)" ]] || fail "Cloud has uncommitted changes."
  git -C "$ROOT" merge-base --is-ancestor HEAD origin/main || fail "Push the Olympus commit before deploying."
  git -C "$cloud_dir" merge-base --is-ancestor HEAD origin/main || fail "Push the Cloud commit before deploying."
  cloud_commit="$(git -C "$cloud_dir" rev-parse HEAD)"
  info "Deploying Nextcloud on root@150.164.110.10 from Cloud commit ${cloud_commit:0:12}"
  ssh -T -o BatchMode=yes root@150.164.110.10 'if [ ! -e /root/cloud-security-deploy ]; then git clone --no-hardlinks /root/cloud /root/cloud-security-deploy; fi; test -d /root/cloud-security-deploy/.git' || fail "Could not prepare the separate Cloud checkout."
  git -C "$cloud_dir" push ssh://root@150.164.110.10/root/cloud-security-deploy "$cloud_commit:refs/heads/security-update" || fail "Could not transfer the pushed Cloud commit to the server."
  ssh -T -o BatchMode=yes root@150.164.110.10 "bash -se -- $cloud_commit" <<'REMOTE_NEXTCLOUD'
set -Eeuo pipefail
expected_commit="$1"
repo=/root/cloud-security-deploy
live=/root/cloud/nextcloud-deploy
image=fafar-nextcloud-php8.5.12:2026-10-21
[[ -d "$repo/.git" ]] || { echo '[ERROR] Security checkout path is not a Git repository.' >&2; exit 1; }
[[ -z "$(git -C "$repo" status --porcelain)" ]] || { echo '[ERROR] Security checkout has local changes.' >&2; exit 1; }
[[ "$(git -C "$repo" rev-parse security-update)" == "$expected_commit" ]] || { echo '[ERROR] Transferred Cloud commit does not match local review.' >&2; exit 1; }
git -C "$repo" merge-base --is-ancestor HEAD security-update || { echo '[ERROR] Security checkout has divergent commits.' >&2; exit 1; }
git -C "$repo" switch --force-create main security-update
[[ -f "$live/docker-compose.yml" && -f "$live/.env" ]] || { echo '[ERROR] Existing Nextcloud deployment is missing.' >&2; exit 1; }
docker inspect nextcloud-app >/dev/null
docker build --pull -t "$image" -f "$repo/nextcloud-deploy/Dockerfile.php8.5.12" "$repo/nextcloud-deploy"
docker run --rm --entrypoint php "$image" -r 'exit(PHP_VERSION_ID === 80512 ? 0 : 1);'
docker run --rm --entrypoint apache2ctl "$image" -t
cd "$live"
compose=(docker compose -p nextcloud-deploy --project-directory "$live" -f "$live/docker-compose.yml" -f "$repo/nextcloud-deploy/compose.php2shell.yaml")
"${compose[@]}" config --quiet
"${compose[@]}" up -d --no-deps --wait --wait-timeout 120 app
docker exec nextcloud-app php -r 'exit(PHP_VERSION_ID === 80512 ? 0 : 1);'
docker exec nextcloud-app apache2ctl -M 2>/dev/null | grep -q 'php_module'
curl -fsS --max-time 10 http://127.0.0.1:8080/status.php >/dev/null
echo '[INFO] Nextcloud app is healthy and runs PHP 8.5.12.'
REMOTE_NEXTCLOUD
}
compose_files() {
  local reverse_proxy_dir
  reverse_proxy_dir="$(repo_dir reverse-proxy)"
  export REVERSE_PROXY_DIR="$reverse_proxy_dir"
  COMPOSE=(docker compose --project-directory "$ROOT" --env-file "$ENVFILE" -f "$ROOT/compose.yaml" -f "$reverse_proxy_dir/compose.olympus.yaml")
  if [[ "$ENVIRONMENT" == dev ]]; then
    COMPOSE+=(--profile dev)
    COMPOSE+=(-f "$ROOT/compose.dev.yaml")
    COMPOSE+=(-f "$reverse_proxy_dir/compose.olympus.dev.yaml")
  fi
  if [[ "$ENVIRONMENT" == prod ]]; then
    COMPOSE+=(--env-file "$reverse_proxy_dir/.env")
    COMPOSE+=(-f "$ROOT/compose.prod.yaml")
    if [[ -f "$ROOT/compose.prod.local.yaml" ]]; then
      COMPOSE+=(-f "$ROOT/compose.prod.local.yaml")
    fi
    COMPOSE+=(-f "$reverse_proxy_dir/compose.olympus.prod.yaml")
    COMPOSE+=(-f "$ROOT/compose.prod.cleanup.yaml")
  fi
}
read_app() {
  local requested="$1" line scope
  APP_URL= APP_SERVICES= APP_DOMAINS= APP_ENV_REQUIRED=true APP_ENV_SCOPE=all
  while IFS=$'\t' read -r name url services domains required scope || [[ -n "${name:-}" ]]; do
    [[ -z "${name:-}" || "$name" == \#* ]] && continue
    if [[ "$name" == "$requested" ]]; then APP_URL="$url"; APP_SERVICES="$services"; APP_DOMAINS="$domains"; APP_ENV_REQUIRED="$required"; APP_ENV_SCOPE="${scope:-all}"; return 0; fi
  done < "$MANIFEST"
  return 1
}
apps() { awk -F '\t' -v env="$ENVIRONMENT" 'NF>=4 && $1 !~ /^#/ && ($6=="" || $6=="all" || $6==env) {print $1}' "$MANIFEST"; }
app_enabled_in_environment() { [[ "$APP_ENV_SCOPE" == all || "$APP_ENV_SCOPE" == "$ENVIRONMENT" ]]; }
repo_dir() { printf '%s/%s' "$WORKSPACE" "$1"; }

copy_workspace_readme() {
  local source="$ROOT/README.workspace.md" source_dir target tmp
  source_dir="$(dirname -- "$source")"
  target="$(cd -- "$source_dir/.." && pwd -P)/README.md"
  if [[ ! -f "$source" ]]; then info "README source is missing; leaving workspace README untouched."; return 0; fi
  tmp="$(mktemp "$(dirname -- "$target")/.README.md.XXXXXX")"
  cp -- "$source" "$tmp"
  mv -f -- "$tmp" "$target"
  info "Published workspace README from olympus/README.workspace.md"
}
prepare_app_env() {
  local app="$1" dir example env dockerignore
  dir="$(repo_dir "$app")"; example="$dir/.env.example"; env="$dir/.env"
  if [[ "$ENVIRONMENT" == prod && -f "$dir/.env.production.example" ]]; then
    example="$dir/.env.production.example"
  fi
  dockerignore="$dir/.dockerignore"
  [[ "$app" != reverse-proxy ]] || dockerignore="$dir/web-server/.dockerignore"
  [[ -d "$dir/.git" ]] || fail "Missing checkout for '$app' at $dir"
  [[ -f "$env" ]] || {
    if [[ -f "$example" ]]; then cp -- "$example" "$env"; chmod 600 "$env"; info "Created $app/.env from $(basename -- "$example"); review placeholders before startup.";
    elif [[ "$APP_ENV_REQUIRED" == true ]]; then fail "'$app' has no .env or .env.example. Add a reviewed template, then retry.";
    else return 0; fi
  }
  if [[ -f "$example" ]]; then
    grep -Eq '(^|/)\.env(\*|\.\*|[[:space:]]|$)' "$dir/.gitignore" 2>/dev/null || fail "'$app' must ignore .env in its .gitignore"
  elif [[ "$APP_ENV_REQUIRED" == true ]]; then
    fail "'$app' needs a versioned .env.example before deployment."
  fi
  grep -Eq '(^|/)\.env(\*|\.\*|[[:space:]]|$)' "$dockerignore" 2>/dev/null || fail "'$app' must exclude .env from its Docker build context via .dockerignore"
  if [[ "$ENVIRONMENT" == dev && "$app" == hermes ]]; then
    local tmp
    tmp="$(mktemp)"
    awk -F= '
      {
        key=$1; sub(/^export[[:space:]]+/, "", key)
        if (key ~ /^HERMES_ENCRYPTION_(PRIMARY_KEY|DETERMINISTIC_KEY|KEY_DERIVATION_SALT)$/ && $2 ~ /__REQUIRED__/) next
        print
      }
    ' "$env" > "$tmp"
    chmod 600 "$tmp"
    mv -- "$tmp" "$env"
  fi
  local required_key value
  while IFS= read -r required_key; do
    [[ -n "$required_key" ]] || continue
    if [[ "$ENVIRONMENT" == dev && "$app" == hermes && "$required_key" =~ ^HERMES_ENCRYPTION_(PRIMARY_KEY|DETERMINISTIC_KEY|KEY_DERIVATION_SALT)$ ]]; then continue; fi
    value="$(awk -F= -v k="$required_key" '$1==k {sub(/^[^=]*=/, ""); print; exit}' "$env")"
    [[ -n "$value" && "$value" != *__REQUIRED__* ]] || fail "'$app'/.env still needs a value for $required_key."
  done < <(awk -F= '$2 ~ /__REQUIRED__/ {print $1}' "$example")
  if awk '!/^[[:space:]]*#/' "$env" | grep -Eq '(^|=)(changeme|change_me|password|your_.*_here|asdfasdf|TODO)([[:space:]]|$)|__REQUIRED__'; then fail "'$app'/.env contains a known placeholder; edit it before startup."; fi
}
ensure_dev_hosts() {
  [[ "$ENVIRONMENT" == dev ]] || return 0
  local domains host line add=() cleanup_tmp backup stale reply add_text

  # Older Olympus versions mapped official production hostnames to localhost.
  # Drop only those tool-managed aliases; keep all *.farmacia.local dev names.
  cleanup_tmp="$(mktemp)"
  awk '
    $1 == "127.0.0.1" && /# olympus-managed/ {
      kept = 0
      line = "127.0.0.1"
      for (i = 2; i <= NF && $i != "#"; i++) {
        if ($i != "true" && $i !~ /\.farmacia\.ufmg\.br$/) {
          line = line " " $i
          kept++
        }
      }
      if (kept) print line " # olympus-managed dev"
      next
    }
    { print }
  ' /etc/hosts > "$cleanup_tmp"
  chmod 644 "$cleanup_tmp"
  if ! cmp -s /etc/hosts "$cleanup_tmp"; then
    backup="$(mktemp /tmp/olympus-hosts-backup.XXXXXX)"
    cp -- /etc/hosts "$backup"
    chmod 600 "$backup"
    if [[ "$EUID" == 0 ]] || { command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; }; then
      if [[ "$EUID" == 0 ]]; then
        install -m 644 -- "$cleanup_tmp" /etc/hosts
      else
        sudo -n install -m 644 -- "$cleanup_tmp" /etc/hosts
      fi
      info "Removed stale development mappings for production domains; backup: $backup"
    else
      stale="$(awk '$1 == "127.0.0.1" && /# olympus-managed/ { for (i = 2; i <= NF && $i != "#"; i++) if ($i == "true" || $i ~ /\.farmacia\.ufmg\.br$/) printf "%s ", $i }' /etc/hosts)"
      if [[ -t 0 && -r /dev/tty ]] && command -v sudo >/dev/null 2>&1; then
        printf 'Remover os aliases antigos de produção do /etc/hosts? [s/N]\n%s\nBackup: %s\n' "$stale" "$backup" > /dev/tty
        read -r reply < /dev/tty || reply=""
        case "$reply" in
          s|S|sim|SIM|y|Y|yes|YES)
            if sudo -v && sudo install -m 644 -- "$cleanup_tmp" /etc/hosts; then
              info "Removed stale development mappings for production domains; backup: $backup"
            else
              info "Permission was not granted; stale production aliases remain in /etc/hosts. Backup: $backup"
            fi
            ;;
          *) info "No changes made to /etc/hosts. Remove these stale production aliases as an administrator if needed: $stale (backup: $backup)" ;;
        esac
      else
        info "Development now uses only *.farmacia.local. Remove these stale production aliases from /etc/hosts as an administrator: $stale (backup: $backup)"
      fi
    fi
  fi
  rm -f -- "$cleanup_tmp"

  while IFS=$'\t' read -r name url services domains required || [[ -n "${name:-}" ]]; do
    [[ -z "${name:-}" || "$name" == \#* || -z "${domains:-}" || "$domains" == "-" ]] && continue
    IFS=',' read -ra domain_list <<<"$domains"
    for host in "${domain_list[@]}"; do
      [[ "$host" == *.local ]] || continue
      if ! awk -v h="$host" 'BEGIN{found=0} /^[[:space:]]*#/ {next} {for(i=2;i<=NF;i++) if ($i==h) found=1} END{exit !found}' /etc/hosts; then add+=("127.0.0.1 $host # olympus-managed"); fi
    done
  done < "$MANIFEST"
  ((${#add[@]})) || return 0
  add_text="$(printf '%s\n' "${add[@]}")"
  if [[ "$EUID" == 0 ]]; then
    printf '%s\n' "$add_text" >> /etc/hosts || fail "Could not update /etc/hosts."
    info "Added local development hostnames to /etc/hosts."
    return 0
  fi
  if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    printf '%s\n' "$add_text" | sudo tee -a /etc/hosts >/dev/null || fail "Could not update /etc/hosts; no hostnames were claimed as configured."
    info "Added local development hostnames to /etc/hosts."
    return 0
  fi
  if [[ ! -t 0 || ! -r /dev/tty ]]; then
    info "Could not update /etc/hosts without an interactive terminal; add these entries as an administrator: $add_text"
    return 0
  fi
  printf 'Adicionar estas entradas ao /etc/hosts? [s/N]\n%s\n' "$add_text" > /dev/tty
  read -r reply < /dev/tty || reply=""
  case "$reply" in
    s|S|sim|SIM|y|Y|yes|YES) ;;
    *) info "No changes made to /etc/hosts. Add these entries as an administrator if needed: $add_text"; return 0 ;;
  esac
  command -v sudo >/dev/null 2>&1 || { info "sudo is unavailable; add these entries as an administrator: $add_text"; return 0; }
  sudo -v || { info "Permission was not granted; no changes made to /etc/hosts."; return 0; }
  printf '%s\n' "$add_text" | sudo tee -a /etc/hosts >/dev/null || fail "Could not update /etc/hosts; no hostnames were claimed as configured."
  info "Added local development hostnames to /etc/hosts."
}

validate_olympus_env() {
  local key value
  local required=(POSTGRES_USER POSTGRES_PASSWORD)
  if [[ "$ENVIRONMENT" == prod ]]; then
    required+=(MYSQL_USER MYSQL_PASSWORD MYSQL_ROOT_PASSWORD WORDPRESS_INSTITUTIONAL_PATH WORDPRESS_INTRANET_PATH CRONOS_ALLOWED_NETWORKS)
  fi
  for key in "${required[@]}"; do
    value="$(awk -F= -v k="$key" '$1==k {sub(/^[^=]*=/, ""); print; exit}' "$ENVFILE")"
    [[ -n "$value" && "$value" != *__REQUIRED__* ]] || fail "olympus/.env needs a value for $key before startup."
  done
}

check_docker() {
  need docker
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 plugin is required."
  docker info >/dev/null 2>&1 || fail "Docker daemon unavailable (check service and permissions)."
}
check_prerequisites() { need git; need curl; check_docker; }
state_label() {
  case "$1" in
    created) printf '[!] criado';; restarting) printf '[!] reiniciando' ;; running) printf '[OK] rodando' ;;
    removing) printf '[!] removendo' ;; paused) printf '[!] pausado' ;; exited) printf '[ERRO] parado' ;;
    dead) printf '[ERRO] encerrado com erro' ;; *) printf '[?] %s' "$1" ;;
  esac
}
health_label() {
  case "$1" in
    healthy) printf '[OK] saudável' ;; unhealthy) printf '[ERRO] não saudável' ;;
    starting) printf '[!] verificando' ;; 'sem healthcheck') printf '[--] sem healthcheck' ;;
    *) printf '[?] %s' "$1" ;;
  esac
}
status_color_enabled() {
  local mode="${OLYMCTL_COLOR:-auto}"
  [[ -z "${NO_COLOR:-}" ]] || return 1
  [[ "$mode" != never ]] || return 1
  [[ "$mode" == always ]] && return 0
  [[ -t 1 && "${TERM:-dumb}" != dumb ]]
}
status_table() {
  local value column width padding color reset='' color_enabled=false
  local -a cells=("$@") widths=(0 0 0 0 0 0 0 0 0)
  if ((${#cells[@]} % 9 != 0)); then
    fail "Internal error: status table needs nine columns."
  fi
  if status_color_enabled; then
    color_enabled=true
    reset=$'\033[0m'
  fi
  for ((i=0; i<${#cells[@]}; i++)); do
    column=$((i % 9))
    value="${cells[$i]}"
    width=${#value}
    ((width <= widths[column])) || widths[column]="$width"
  done
  widths[0]=$((widths[0] + 1))
  for ((i=0; i<${#cells[@]}; i++)); do
    column=$((i % 9))
    value="${cells[$i]}"
    if ((column == 0)); then printf '|'; fi
    padding=$((widths[column] - ${#value}))
    if ((column == 1 || column == 2)) && ((i >= 9)) && [[ "$color_enabled" == true ]]; then
      case "$value" in
        '[OK]'*) color=$'\033[32m' ;;
        '[ERRO]'*) color=$'\033[31m' ;;
        '[!]'*|'[?]'*) color=$'\033[33m' ;;
        *) color=$'\033[90m' ;;
      esac
    else
      color=''
    fi
    if ((column <= 2)); then
      printf ' %s%s%s%*s |' "$color" "$value" "$reset" "$padding" ''
    else
      printf ' %*s%s |' "$padding" '' "$value"
    fi
    if ((column == 8)); then
      printf '\n'
      if ((i == 8)); then
        for ((column=0; column<9; column++)); do
          printf '|'
          printf -v value '%*s' "$((widths[column] + 2))" ''
          printf '%s' "${value// /-}"
        done
        printf '|\n'
      fi
    fi
  done
}
check_clean() {
  local dir="$1" label="$2" branch upstream tip
  [[ -d "$dir/.git" ]] || return 0
  if [[ -n "$(git -C "$dir" status --porcelain)" ]]; then fail "'$label' has uncommitted changes; commit or stash them before changing revisions."; fi
  branch="$(git -C "$dir" branch --show-current)"
  if [[ -n "$branch" ]]; then
    upstream="$(git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
    if [[ -n "$upstream" ]]; then
      tip="$(git -C "$dir" rev-parse HEAD)"
      git -C "$dir" merge-base --is-ancestor "$tip" "$upstream" || fail "'$label' has local commits not present on '$upstream'; preserve them before switching."
    fi
  fi
}
update_olympus() {
  local no_pull="$1" current target branch
  shift
  [[ "$no_pull" == true ]] && return 0
  need git
  git -C "$ROOT" fetch origin main || fail "Could not fetch Olympus main."
  check_clean "$ROOT" "olympus"
  current="$(git -C "$ROOT" rev-parse HEAD)"
  target="$(git -C "$ROOT" rev-parse origin/main)"
  branch="$(git -C "$ROOT" branch --show-current)"
  if [[ "$current" != "$target" || "$branch" != main ]]; then
    git -C "$ROOT" merge-base --is-ancestor "$current" "$target" || fail "Olympus has local commits outside origin/main; preserve them before updating."
    git -C "$ROOT" switch --force-create main "$target" >/dev/null || fail "Could not switch Olympus to updated main."
    info "Updated Olympus: ${current:0:12} -> ${target:0:12}; restarting the requested command."
    exec "$ROOT/olymctl" "$@"
  fi
}
record() {
  local env="$1" type="$2" app="$3" from="$4" to="$5" result="$6" detail="${7:-}" id now
  mkdir -p "$STATE"; touch "$HISTORY"; exec 9>"$LOCK"; flock -x 9
  id="$(($(tail -n 1 "$STATE/next-id" 2>/dev/null || printf '0') + 1))"
  printf '%s\n' "$id" > "$STATE/next-id.tmp"; mv "$STATE/next-id.tmp" "$STATE/next-id"
  now="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$now" "$env" "$type" "$app" "$from" "$to" "$result${detail:+; $detail}" >> "$HISTORY"
  flock -u 9
  printf '%s' "$id"
}
previous_deployment() {
  local env="$1" app="$2" current="$3"
  awk -F '\t' -v e="$env" -v a="$app" -v c="$current" '$3==e && ($5==a || (a=="escuta" && $5=="escuta-website")) && $4=="up" && $8 ~ /^success/ {items[++n]=$7} END {for (i=n;i>=1;i--) if (items[i]==c) {if (i>1) print items[i-1]; exit}}' "$HISTORY" 2>/dev/null
}
compose_app_services() {
  local app="$1" service
  IFS=',' read -ra names <<<"$APP_SERVICES"
  for service in "${names[@]}"; do [[ -n "$service" ]] && SELECTED+=("$service"); done
}
is_production_wordpress() {
  [[ "$1" == institutional-website || "$1" == intranet-website ]]
}
check_wordpress_php() {
  local target="$1"
  docker run --rm --entrypoint php "$target" -r '
    if (PHP_MAJOR_VERSION !== 8 || PHP_MINOR_VERSION !== 3 || PHP_VERSION_ID < 80336) {
      fwrite(STDERR, "PHP 8.3.36 or newer in the 8.3 series is required; found " . PHP_VERSION . "\n");
      exit(1);
    }
  ' || fail "Refusing to deploy WordPress with an unpatched PHP image."
}
prepare_wordpress_image() {
  info "Building and checking WordPress with patched PHP 8.3 before deployment."
  docker build --pull -t olympus-wordpress-php8.3.36 -f "$ROOT/wordpress/Dockerfile.php8.3.36" "$ROOT/wordpress" || fail "Could not build the patched WordPress image."
  check_wordpress_php olympus-wordpress-php8.3.36
  docker run --rm --entrypoint apache2ctl olympus-wordpress-php8.3.36 -t || fail "The patched WordPress Apache configuration is invalid."
}
prepare_git() {
  local app="$1" url="$2" dir branch="$3" commit="$4" no_pull="$5" old="" target=""
  dir="$(repo_dir "$app")"
  if [[ ! -e "$dir" ]]; then
    [[ "$no_pull" == true ]] && fail "'$app' checkout is missing and --no-pull prevents cloning. Clone it from $url first."
    [[ -n "$url" ]] || fail "No verified Git origin for '$app'; clone/restore it manually and configure apps.tsv."
    git clone --branch main -- "$url" "$dir"
  elif [[ ! -d "$dir/.git" ]]; then fail "'$dir' exists but is not a Git checkout; refusing to overwrite it."; fi
  old="$(git -C "$dir" rev-parse HEAD 2>/dev/null || true)"
  if [[ "$no_pull" == true ]]; then [[ -n "$old" ]] || fail "'$app' is not a usable Git checkout"; return 0; fi
  check_clean "$dir" "$app"
  [[ -n "$branch" ]] || branch=main
  git -C "$dir" fetch origin "$branch" || fail "Could not fetch '$branch' for '$app'."
  if [[ -n "$commit" ]]; then
    git -C "$dir" cat-file -e "$commit^{commit}" 2>/dev/null || fail "Commit '$commit' is not available in '$app'."
    git -C "$dir" merge-base --is-ancestor "$commit" "origin/$branch" || fail "Commit '$commit' is not in branch '$branch' for '$app'."
    target="$commit"
  else target="origin/$branch"; fi
  if git -C "$dir" show-ref --verify --quiet "refs/heads/$branch"; then
    local branch_tip
    branch_tip="$(git -C "$dir" rev-parse "refs/heads/$branch")"
    git -C "$dir" merge-base --is-ancestor "$branch_tip" "$target" || fail "'$app' branch '$branch' contains local commits outside the requested revision; preserve them before switching."
  fi
  git -C "$dir" switch --force-create "$branch" "$target" >/dev/null
  [[ -n "$commit" ]] && git -C "$dir" checkout --detach "$commit" >/dev/null
  [[ -z "$old" || "$old" == "$(git -C "$dir" rev-parse HEAD)" ]] || info "$app: $(git -C "$dir" rev-parse --short HEAD)"
}

up() {
  local env="$1" app_filter="${2:-}" no_pull="$3" branch="$4" commit="$5" prepare_only="${6:-false}" app service url services domains required dir old sha id= status=success failed=0
  ENVIRONMENT="$env"; check_prerequisites; [[ -f "$ENVFILE" ]] || { [[ -f "$ROOT/.env.example" ]] || fail "Missing Olympus .env.example"; cp -- "$ROOT/.env.example" "$ENVFILE"; chmod 600 "$ENVFILE"; info "Created olympus/.env from .env.example; configure its database credentials."; }
  validate_olympus_env
  copy_workspace_readme
  ensure_dev_hosts
  SELECTED=(); local -a chosen=()
  if [[ -n "$app_filter" ]]; then chosen=("$app_filter"); else mapfile -t chosen < <(apps); fi
  # Route changes must deploy the matching proxy checkout together.
  if [[ "$app_filter" == escuta || "$app_filter" == athenas ]]; then
    read_app reverse-proxy || fail "Missing reverse-proxy application."
    prepare_git reverse-proxy "$APP_URL" "" "" "$no_pull"
    prepare_app_env reverse-proxy
  fi
  local -a affected=()
  declare -A previous_sha=() deployed_sha=()
  for app in "${chosen[@]}"; do
    read_app "$app" || fail "Unknown application '$app'."
    app_enabled_in_environment || fail "'$app' is not enabled in $env."
    [[ -n "$app_filter" || ( -z "$branch" && -z "$commit" ) ]] || fail "--branch and --commit require an individual application up."
    if [[ "$app" == escuta ]]; then
      need python3
      local -a rename_arguments=(--workspace "$WORKSPACE")
      [[ "$env" != prod ]] || rename_arguments+=(--production-override "$ROOT/compose.prod.local.yaml")
      python3 "$ROOT/scripts/migrate-escuta-name.py" "${rename_arguments[@]}" || fail "Could not migrate the Escuta checkout."
    fi
    dir="$(repo_dir "$app")"; old="$(git -C "$dir" rev-parse HEAD 2>/dev/null || true)"
    if [[ "$env" == prod ]] && is_production_wordpress "$app"; then
      [[ -z "$branch$commit" ]] || fail "WordPress services use the Olympus Compose configuration; --branch and --commit do not apply."
      old="$(git -C "$ROOT" rev-parse HEAD)"
      sha="$old"
    else
      prepare_git "$app" "$APP_URL" "$branch" "$commit" "$no_pull"
      prepare_app_env "$app"
      sha="$(git -C "$dir" rev-parse HEAD)"
    fi
    previous_sha["$app"]="$old"; deployed_sha["$app"]="$sha"
    compose_app_services "$app"; affected+=("$app:$old:$sha")
  done
  if [[ "$prepare_only" == true ]]; then
    info "Prepared production services for ${chosen[*]}; no services were started or restarted."
    return 0
  fi
  if [[ "$env" == prod ]]; then
    for app in "${chosen[@]}"; do
      if is_production_wordpress "$app"; then prepare_wordpress_image; break; fi
    done
  fi
  SELECTED+=(reverse-proxy)
  compose_files
  local -a cmd=("${COMPOSE[@]}" up -d --build --remove-orphans)
  # The proxy bind-mounts a single Caddyfile. Git may replace that file's inode
  # while updating routes, leaving the existing container pinned to stale data.
  # Recreate it for route-affecting deploys before reloading Caddy.
  [[ "$app_filter" != reverse-proxy && "$app_filter" != athenas && "$app_filter" != escuta ]] || cmd+=(--force-recreate)
  cmd+=("${SELECTED[@]}")
  id="$(record "$env" up "${app_filter:-all}" "" "" started)"
  if ! "${cmd[@]}"; then status=failed; failed=1; fi
  if [[ "$failed" == 0 && "$env" == prod ]]; then
    for app in "${chosen[@]}"; do
      if is_production_wordpress "$app"; then
        for service in institutional-website intranet-website; do
          if ! "${COMPOSE[@]}" exec -T "$service" php -r 'exit(PHP_MAJOR_VERSION === 8 && PHP_MINOR_VERSION === 3 && PHP_VERSION_ID >= 80336 ? 0 : 1);'; then
            info "The deployed $service container did not report patched PHP 8.3."
            status=failed; failed=1
          fi
        done
        break
      fi
    done
  fi
  if [[ "$failed" == 0 ]]; then
    # A bind-mounted Caddyfile can change without changing the proxy image.
    if ! "${COMPOSE[@]}" exec -T reverse-proxy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile; then
      status=failed; failed=1
    fi
  fi
  for app in "${chosen[@]}"; do record "$env" up "$app" "${previous_sha[$app]}" "${deployed_sha[$app]}" "$([[ $failed == 0 ]] && echo success || echo failed)" "deploy=$id" >/dev/null; done
  [[ "$failed" == 0 ]] || fail "Deploy $id failed; no automatic rollback was attempted. Inspect docker compose logs."
  info "Deploy $id completed for ${chosen[*]}"
}

up_dev_infrastructure() {
  local service="$1" id
  ENVIRONMENT=dev; check_prerequisites
  [[ -f "$ENVFILE" ]] || { [[ -f "$ROOT/.env.example" ]] || fail "Missing Olympus .env.example"; cp -- "$ROOT/.env.example" "$ENVFILE"; chmod 600 "$ENVFILE"; info "Created olympus/.env from .env.example; configure its database credentials."; }
  validate_olympus_env
  compose_files
  id="$(record dev up "$service" "" "" started)"
  if ! "${COMPOSE[@]}" up -d "$service"; then
    record dev up "$service" "" "" failed "deploy=$id" >/dev/null
    fail "Could not start requested development service."
  fi
  record dev up "$service" "" "" success "deploy=$id" >/dev/null
  info "Started development service $service (deploy $id)."
}

rollback() {
  local env="$1" app="$2" requested="$3" url services domains required dir current target
  ENVIRONMENT="$env"; check_prerequisites; read_app "$app" || fail "Unknown application '$app'."; app_enabled_in_environment || fail "'$app' is not enabled in $env."
  dir="$(repo_dir "$app")"; [[ -d "$dir/.git" ]] || fail "Missing checkout for '$app'."
  check_clean "$dir" "$app"; current="$(git -C "$dir" rev-parse HEAD)"
  target="$requested"; [[ -n "$target" ]] || target="$(previous_deployment "$env" "$app" "$current")"
  [[ -n "$target" ]] || fail "No earlier successful deployment is recorded for '$app'."
  git -C "$dir" cat-file -e "$target^{commit}" 2>/dev/null || fail "Commit '$target' is not available locally; fetch it before rollback."
  git -C "$dir" checkout --detach "$target" >/dev/null
  prepare_app_env "$app"; compose_app_services "$app"; compose_files
  local id; id="$(record "$env" rollback "$app" "$current" "$target" started)"
  if ! "${COMPOSE[@]}" up -d --build "${SELECTED[@]}"; then record "$env" rollback "$app" "$current" "$target" failed "deploy=$id" >/dev/null; fail "Rollback $id failed; no automatic recovery was attempted."; fi
  record "$env" rollback "$app" "$current" "$target" success "deploy=$id" >/dev/null
  info "Rollback $id completed: $app $current -> $target"
}

status() {
  local env="$1" id details name state health exit_code lifecycle cpu mem memory_pct net_io block_io pid timestamp container_ids stats_output
  local -a ids=() running_ids=() names=()
  local -a table_cells=('Container' 'Estado' 'Saúde' 'CPU' 'RAM (uso / limite)' 'RAM %' 'NET I/O (RX / TX)' 'DISK I/O (leitura / escrita)' 'PIDs')
  local -A states=() healths=() cpus=() memories=() memory_pcts=() net_ios=() block_ios=() pids=()
  ENVIRONMENT="$env"; check_docker; compose_files
  container_ids="$("${COMPOSE[@]}" ps -a -q)" || fail "Could not list $env containers."
  [[ -z "$container_ids" ]] || mapfile -t ids <<<"$container_ids"
  if ((${#ids[@]} == 0)); then info "No containers found for $env."; return 0; fi
  for id in "${ids[@]}"; do
    details="$(docker inspect --format '{{.Name}}|{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}sem healthcheck{{end}}|{{.State.ExitCode}}|{{index .Config.Labels "olympus.lifecycle"}}' "$id")"
    IFS='|' read -r name state health exit_code lifecycle <<<"$details"
    name="${name#/}"
    names+=("$name")
    if [[ "$state" == exited && "$exit_code" == 0 && "$lifecycle" == oneshot ]]; then
      states["$name"]="[OK] concluído"
    else
      states["$name"]="$(state_label "$state")"
    fi
    healths["$name"]="$(health_label "$health")"
    [[ "$state" != running ]] || running_ids+=("$id")
  done
  if ((${#running_ids[@]})); then
    stats_output="$(docker stats --no-stream --format '{{.Name}}|{{.CPUPerc}}|{{.MemUsage}}|{{.MemPerc}}|{{.NetIO}}|{{.BlockIO}}|{{.PIDs}}' "${running_ids[@]}")" || fail "Could not collect container resource statistics."
    while IFS='|' read -r name cpu mem memory_pct net_io block_io pid; do
      [[ -n "$name" ]] || continue
      name="${name#/}"
      cpus["$name"]="$cpu"
      memories["$name"]="$mem"
      memory_pcts["$name"]="$memory_pct"
      net_ios["$name"]="$net_io"
      block_ios["$name"]="$block_io"
      pids["$name"]="$pid"
    done <<<"$stats_output"
  fi
  timestamp="$(date '+%Y-%m-%d %H:%M:%S %Z')"
  printf 'Snapshot %s | ambiente: %s\n' "$timestamp" "$env"
  printf 'I/O de rede e disco são acumulados desde o início do container.\n\n'
  for name in "${names[@]}"; do
    table_cells+=("$name" "${states[$name]}" "${healths[$name]}" "${cpus[$name]:-—}" \
      "${memories[$name]:-—}" "${memory_pcts[$name]:-—}" "${net_ios[$name]:-—}" \
      "${block_ios[$name]:-—}" "${pids[$name]:-—}")
  done
  status_table "${table_cells[@]}"
}

ports() {
  local env="$1" id container_ids
  local -a ids=()
  ENVIRONMENT="$env"; check_docker; compose_files
  container_ids="$("${COMPOSE[@]}" ps -a -q)" || fail "Could not list $env containers."
  [[ -z "$container_ids" ]] || mapfile -t ids <<<"$container_ids"
  if ((${#ids[@]} == 0)); then info "No containers found for $env."; return 0; fi
  printf 'Ambiente: %s\n' "$env"
  printf 'Portas internas são as declaradas pela imagem/configuração; publicação indica host → container.\n\n'
  for id in "${ids[@]}"; do
    docker inspect --format='Container: {{.Name}}
  Estado: {{if eq .State.Status "running"}}rodando{{else if eq .State.Status "exited"}}parado{{else if eq .State.Status "restarting"}}reiniciando{{else if eq .State.Status "paused"}}pausado{{else}}{{.State.Status}}{{end}}
  Portas internas declaradas: {{range $port, $config := .Config.ExposedPorts}}{{$port}} {{else}}nenhuma{{end}}
  Portas publicadas: {{range $port, $bindings := .NetworkSettings.Ports}}{{if $bindings}}{{range $bindings}}{{.HostIp}}:{{.HostPort}} → {{$port}} {{end}}{{else}}{{$port}} (somente rede Docker) {{end}}{{else}}nenhuma{{end}}' "$id"
    printf '\n'
  done
}

usage() { cat <<'EOF'
Usage:
  olymctl dev up [app|reverse-proxy|postgres-db|mongo-db|mysql-db] [--no-pull] [--branch NAME] [--commit SHA]
  olymctl prod [--remote] up [app|nextcloud] [--no-pull] [--branch NAME] [--commit SHA] [--prepare-only]
  olymctl dev|prod [--remote] rollback app [--commit SHA]
  olymctl prod --remote down app
  olymctl dev|prod [--remote] status
  olymctl dev|prod [--remote] ports
  olymctl dev|prod down [app]
  olymctl history
EOF
}
main() {
  [[ $# -ge 1 ]] || { usage; exit 2; }
  local -a original_args=("$@")
  if [[ "$1" == history ]]; then [[ -f "$HISTORY" ]] && cat "$HISTORY" || info "No deploy history yet."; return; fi
  local env="$1" action="" app="" no_pull=false branch="" commit="" remote=false prepare_only=false
  shift
  if [[ "${1:-}" == --remote ]]; then remote=true; shift; fi
  action="${1:-}"
  shift || true
  [[ "$env" == dev || "$env" == prod ]] || { usage; exit 2; }
  case "$action" in
    up)
      if [[ $# -gt 0 && "$1" != --* ]]; then app="$1"; shift; fi
      while (($#)); do case "$1" in --no-pull) no_pull=true;; --branch) (($#>=2)) || fail "--branch needs a value"; branch="$2"; shift;; --commit) (($#>=2)) || fail "--commit needs a value"; commit="$2"; shift;; --remote) remote=true;; --prepare-only) prepare_only=true;; *) fail "Unknown up option: $1";; esac; shift; done
      [[ "$prepare_only" == false || "$env" == prod ]] || fail "--prepare-only is supported only for production preparation."
      [[ -z "$branch$commit" || -n "$app" ]] || fail "--branch and --commit apply only to individual application up."
      if [[ "$app" == nextcloud ]]; then
        [[ "$env" == prod && "$remote" == true ]] || fail "Nextcloud deployment requires prod --remote."
        [[ "$no_pull" == false && -z "$branch$commit" && "$prepare_only" == false ]] || fail "Nextcloud deployment does not accept revision or preparation options."
        run_remote_nextcloud
      elif [[ "$app" == postgres-db || "$app" == mongo-db || "$app" == mysql-db ]]; then
        [[ "$env" == dev ]] || fail "Database services can only be started in dev."
        [[ "$remote" == false ]] || fail "Remote infrastructure service startup is not supported."
        [[ -z "$branch$commit" && "$prepare_only" == false ]] || fail "Branch, commit, and prepare-only options apply only to apps."
        up_dev_infrastructure "$app"
      elif [[ "$remote" == true ]]; then
        [[ "$env" == prod ]] || fail "--remote is supported only with prod up."
        local -a remote_args=()
        [[ -z "$app" ]] || remote_args+=("$app")
        [[ "$no_pull" == false ]] || remote_args+=(--no-pull)
        [[ -z "$branch" ]] || remote_args+=(--branch "$branch")
        [[ -z "$commit" ]] || remote_args+=(--commit "$commit")
        [[ "$prepare_only" == false ]] || remote_args+=(--prepare-only)
        run_remote_prod up "${remote_args[@]}"
      else
        update_olympus "$no_pull" "${original_args[@]}"
        up "$env" "$app" "$no_pull" "$branch" "$commit" "$prepare_only"
      fi;;
    rollback)
      [[ $# -ge 1 ]] || fail "rollback needs an application"; app="$1"; shift
      while (($#)); do case "$1" in --commit) (($#>=2)) || fail "--commit needs a value"; commit="$2"; shift;; --remote) remote=true;; *) fail "Unknown rollback option: $1";; esac; shift; done
      if [[ "$remote" == true ]]; then
        [[ "$env" == prod ]] || fail "--remote is supported only with prod rollback."
        local -a remote_args=("$app")
        [[ -z "$commit" ]] || remote_args+=(--commit "$commit")
        run_remote_prod rollback "${remote_args[@]}"
      else
        rollback "$env" "$app" "$commit"
      fi;;
    status|ports)
      while (($#)); do case "$1" in --remote) remote=true;; *) fail "Unknown $action option: $1";; esac; shift; done
      if [[ "$remote" == true ]]; then
        [[ "$env" == prod ]] || fail "--remote is supported only with prod $action."
        run_remote_prod "$action"
      elif [[ "$action" == status ]]; then
        status "$env"
      else
        ports "$env"
      fi;;
    down)
      app=""
      if [[ $# -gt 0 && "$1" != --* ]]; then app="$1"; shift; fi
      while (($#)); do case "$1" in --remote) remote=true;; *) fail "Unknown down option: $1";; esac; shift; done
      if [[ "$remote" == true ]]; then
        [[ "$env" == prod ]] || fail "--remote is supported only with prod down."
        [[ -n "$app" ]] || fail "Remote down requires an application name."
        run_remote_prod down "$app"
      else
        check_prerequisites; ENVIRONMENT="$env"; compose_files
        if [[ -n "$app" ]]; then read_app "$app" || fail "Unknown app '$app'"; app_enabled_in_environment || fail "'$app' is not enabled in $env."; SELECTED=(); compose_app_services "$app"; "${COMPOSE[@]}" stop "${SELECTED[@]}"; else "${COMPOSE[@]}" stop; fi
      fi;;
    *) usage; exit 2;;
  esac
}
main "$@"
